<h1><%= @post.subject %></h1>

<p><%= @post.content %></p>

<% if @post.user_id == current_user.id %>
    <%= button_to "Delete Post", post_path(@post), method: :delete, data: {turbo_confirm: "Are you sure you want to delete the post?"} %>
    <%= link_to "Edit Post", edit_post_path(@post) %>
<% end %>