<h1>User</h1>
<p>User email: <%= @user.email %></p>
<%= gravatar_for @user %>

<h2>Following: <%= @user.friendships.count %></h2>
<ul>
    <% @user.friendships.each do |friendship| %>
        <li>
            <%= friendship.friend.email %>
        </li>
    <% end %>
</ul>
    
<h2>Followers: <%= @user.inverse_friends.count %></h2>
<ul>
    <% @user.inverse_friends.each do |user| %>
        <li>
            <%= user.email %>
        </li>
    <% end %>
</ul>
    
<h2>People to follow</h2>
<ul>
    <% @non_friends.each do |user| %>
        <li>
            <%= user.email %> 
            <% if current_user == @user %>
                <%= button_to "Follow", friendships_path, method: :post, params: { friend_id: user.id } %>
            <% end %>
        </li>
    <% end %>
</ul>

<h2>User Posts</h2>

<ul>
    <% @posts.each do |post| %>
        <li>
            <%= link_to post.subject, post_path(post) %>
        </li>
    <% end %>
</ul>