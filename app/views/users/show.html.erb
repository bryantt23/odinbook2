<h1>Users#show</h1>
<p>Find me in app/views/users/show.html.erb</p>

<h2>Friends</h2>
<ul>
    <% @user.friendships.each do |friendship| %>
        <li>
            <%= friendship.friend.email %>
        </li>
    <% end %>
</ul>
    
<h2>Non-Friends</h2>
<ul>
    <% @non_friends.each do |user| %>
        <li>
            <%= user.email %>
        </li>
    <% end %>
</ul>
    
<h2>Followers</h2>
<ul>
    <% @user.inverse_friends.each do |user| %>
        <li>
            <%= user.email %>
        </li>
    <% end %>
</ul>